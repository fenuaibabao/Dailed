# Copy to .env.local for local development. Never commit real values.
# Convex functions can't read Next.js env vars: anything marked [convex] is set
# on the Convex deployment with `npx convex env set NAME value`.

# --- Convex (written to .env.local by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Convex Auth [convex] ---
# Set all three with `npx @convex-dev/auth` (generates the keys for you).
# SITE_URL is the app's own URL, e.g. http://localhost:3000 or your Vercel URL.
# JWT_PRIVATE_KEY=
# JWKS=
# SITE_URL=

# --- Vapi (used from Milestone 2) ---
# Server only. Never exposed to the browser, logs or API responses.
VAPI_PRIVATE_KEY=
# Browser-safe. Served to the client only through /api/vapi/public-config.
VAPI_PUBLIC_KEY=
# Shared secret the Vapi webhook must present. [next] and [convex]
VAPI_WEBHOOK_SECRET=
# Vapi assistant ID for Remi. Not secret. [convex] (read by the seed)
REMI_ASSISTANT_ID=

# --- LLM processing (used from Milestone 2) ---
# Server only. [convex]
OPENAI_API_KEY=
